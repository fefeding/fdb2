{
  "name": "vscode-fdb2",
  "displayName": "%displayName%",
  "description": "%extension.description%",
  "version": "1.2.22",
  "publisher": "fefeding",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/fdb2.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "keywords": [
    "database",
    "sql",
    "mysql",
    "postgres",
    "postgresql",
    "sqlite",
    "mongodb",
    "oracle",
    "clickhouse",
    "sql editor",
    "database client"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:databaseExplorer",
    "onCommand:dbtool.addConnection",
    "onCommand:dbtool.editConnection",
    "onCommand:dbtool.refreshConnections",
    "onCommand:dbtool.openQueryPanel",
    "onCommand:dbtool.openDatabasePanel",
    "onCommand:dbtool.testConnection",
    "onCommand:dbtool.deleteConnection",
    "onCommand:dbtool.viewTableData",
    "onCommand:dbtool.viewTableStructure",
    "onCommand:dbtool.copyTableName",
    "onCommand:dbtool.copySelectSQL"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbtool",
          "title": "%viewContainer.dbtool.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "dbtool": [
        {
          "id": "databaseExplorer",
          "name": "%view.databaseExplorer.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "dbtool.addConnection",
        "title": "%command.addConnection.title%",
        "icon": "$(add)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.refreshConnections",
        "title": "%command.refreshConnections.title%",
        "icon": "$(refresh)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.openQueryPanel",
        "title": "%command.openQueryPanel.title%",
        "icon": "$(terminal)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.openDatabasePanel",
        "title": "%command.openDatabasePanel.title%",
        "icon": "$(database)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.testConnection",
        "title": "%command.testConnection.title%",
        "icon": "$(check)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.deleteConnection",
        "title": "%command.deleteConnection.title%",
        "icon": "$(trash)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.viewTableData",
        "title": "%command.viewTableData.title%",
        "icon": "$(table)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.viewTableStructure",
        "title": "%command.viewTableStructure.title%",
        "icon": "$(list-unordered)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.editConnection",
        "title": "%command.editConnection.title%",
        "icon": "$(pencil)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.copyTableName",
        "title": "%command.copyTableName.title%",
        "icon": "$(clippy)",
        "category": "%dbtool.category%"
      },
      {
        "command": "dbtool.copySelectSQL",
        "title": "%command.copySelectSQL.title%",
        "icon": "$(code)",
        "category": "%dbtool.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbtool.addConnection",
          "when": "view == databaseExplorer",
          "group": "navigation"
        },
        {
          "command": "dbtool.refreshConnections",
          "when": "view == databaseExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbtool.openDatabasePanel",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbtool.openQueryPanel",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbtool.editConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "connection@1"
        },
        {
          "command": "dbtool.testConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "connection@2"
        },
        {
          "command": "dbtool.deleteConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "connection@3"
        },
        {
          "command": "dbtool.copyTableName",
          "when": "view == databaseExplorer && viewItem == table",
          "group": "table@1"
        },
        {
          "command": "dbtool.copySelectSQL",
          "when": "view == databaseExplorer && viewItem == table",
          "group": "table@2"
        },
        {
          "command": "dbtool.viewTableData",
          "when": "view == databaseExplorer && viewItem == table",
          "group": "table@3"
        },
        {
          "command": "dbtool.viewTableStructure",
          "when": "view == databaseExplorer && viewItem == table",
          "group": "table@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databaseExplorer",
        "contents": "%viewsWelcome.databaseExplorer.contents%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dbtool.queryLimit": {
          "type": "number",
          "default": 200,
          "description": "%config.queryLimit.description%"
        },
        "dbtool.dataDir": {
          "type": "string",
          "default": "",
          "description": "%config.dataDir.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production && cd ../.. && npm run build:vscode -- --minify",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:webview": "cd ../.. && npm run build:vscode",
    "build": "node esbuild.js && cd ../.. && npm run build:vscode",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "@sap/hana-client": "^2.23.18",
    "oracledb": "^6.10.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "ovsx": "^0.10.0",
    "typescript": "^5.9.3"
  }
}
